<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12+ 백업 · 기기 옮기기: AI 태그 모델(files/ai)은 뺀다 (수백 MB, 새 기기에서 다시 받으면 됨) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="ai/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ai/" />
    </device-transfer>
</data-extraction-rules>
