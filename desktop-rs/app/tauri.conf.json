{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoKing",
  "mainBinaryName": "MemoKing",
  "version": "0.88.0",
  "identifier": "com.memoking.desktop",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../assets/icons/icon-256.png",
      "../../assets/icons/memoking.ico"
    ],
    "shortDescription": "바탕화면에 붙여 쓰는 스티커 메모",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/lmg6983-dotcom/MemoKing/releases/download/desktop-rs/latest-tauri.json"
      ]
    }
  }
}
